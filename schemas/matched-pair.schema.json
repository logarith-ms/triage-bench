{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labs.logarith.ms/schemas/triage-bench-matched-pair/v0.2.json",
  "title": "TriageBench matched pair",
  "type": "object",
  "additionalProperties": false,
  "required": ["pair_id", "benchmark_version", "task_ids", "expected_action_change"],
  "properties": {
    "pair_id": { "type": "string", "minLength": 1 },
    "benchmark_version": { "const": "v0.2" },
    "task_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "pattern": "^triage-v02-[0-9]{3}$" }
    },
    "expected_action_change": { "const": true }
  }
}
